# VeriFace-Chain Environment Configuration
# Copy this file to .env and fill in your keys (DO NOT commit .env)

# SerpApi API Key (Optional)
# Used for live Google Lens visual search across public web/social media.
# If not provided, VeriFace-Chain operates in Privacy-First Genesis Origin mode.
SERPAPI_API_KEY=

# Polygon Amoy Testnet Settings (Optional - only needed if running with --chain testnet)
# RPC_URL=https://rpc-amoy.polygon.technology
# PRIVATE_KEY=0x...
